ADDR=:9091
# info and below emit per-request access logs
LOG_LEVEL=info
DATABASE_PATH=data/faux-seer.db
SEER_SHARED_SECRET=seers-also-very-long-value-haha
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=false
LLM_PROVIDER=stub
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini,gpt-4.1-nano
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
EMBEDDING_PROVIDER=stub
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
VECTOR_STORE=sqlitevec
VECTOR_STORE_DSN=postgres://postgres:postgres@127.0.0.1:5432/faux_seer?sslmode=disable
VECTOR_DIMENSIONS=256
SIMILARITY_THRESHOLD=0.1
HTTP_REFERER=
# Every call to an external provider (LLM, embedding, repository host) gives up
# after this long. A provider that accepts a connection and never answers would
# otherwise leave the run that issued the call in "processing" forever, and
# Sentry's poller gives up before that. A host that drops packets fails after a
# fixed 10s dial timeout regardless of this value.
OUTBOUND_TIMEOUT=60s
# Repository access. Without a token the repository-backed endpoints answer with
# their simulated responses instead of failing.
GITHUB_TOKEN=
GITHUB_BASE_URL=https://api.github.com
GITLAB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com/api/v4
GITEA_TOKEN=
GITEA_BASE_URL=
BITBUCKET_TOKEN=
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
# Inline service-account JSON or a path to it. When unset, GCP connection
# verification is simulated.
GCP_SERVICE_ACCOUNT_JSON=
# Code index chunking, in runes.
CODE_INDEX_CHUNK_SIZE=1000
CODE_INDEX_CHUNK_OVERLAP=200
